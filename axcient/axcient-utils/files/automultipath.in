#!/bin/sh

. /etc/rc.subr

name="automultipath"
start_cmd="${name}_start"
stop_cmd="${name}_stop"
rcvar=${name}_enable

automultipath_start() {
	touch "/var/run/${name}"
}

automultipath_stop() {
	if [ -e "/var/run/${name}" ]; then
		rm "/var/run/${name}"
	fi
}

load_rc_config $name
run_rc_command "$1"
