#!/bin/sh
# $FreeBSD$

# PROVIDE: smartctl_exporter
# REQUIRE: LOGIN
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf.local or /etc/rc.conf
# to enable this service:
#
# smartctl_exporter_enable (bool):            Set to NO by default.
#               Set it to YES to enable smartctl-exporter.

. /etc/rc.subr

PATH="${PATH}:%%PREFIX%%/sbin"
name=smartctl_exporter
desc="SMART prometheus exporter"
rcvar=smartctl_exporter_enable

load_rc_config $name

: ${smartctl_exporter_enable:=NO}

pidfile="/var/run/${name}.pid"
command=/usr/sbin/daemon
command_interpreter=%%PYTHON_CMD%%
procname=%%PREFIX%%/bin/smartctl-exporter
command_args="-f -p ${pidfile} /usr/bin/env ${procname}"

start_precmd=smartctl_exporter_startprecmd

smartctl_exporter_startprecmd()
{
	if [ ! -e ${pidfile} ]; then
		install /dev/null ${pidfile};
	fi
}

run_rc_command "$1"
