#!/bin/sh
# $FreeBSD$

# PROVIDE: smartctl_exporter
# REQUIRE: LOGIN
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf.local or /etc/rc.conf
# to enable this service:
#
# smartctl_exporter_enable (bool):            Set to NO by default.
#               Set it to YES to enable smartctl-exporter.
# smartctl_exporter_args (string):            Set extra arguments to pass to smartctl-exporter
#               Default is "".
# smartctl_exporter_user (string):            Set user that smartctl_exporter will run under
#               Default is "prometheus".
# smartctl_exporter_group (string):           Set group that smartctl_exporter will run under
#               Default is "prometheus".

. /etc/rc.subr

name=smartctl_exporter
desc="SMART prometheus exporter"
rcvar=smartctl_exporter_enable

load_rc_config $name

: ${smartctl_exporter_enable:=NO}
: ${smartctl_exporter_args:=""}
: ${smartctl_exporter_user:=prometheus}
: ${smartctl_exporter_group:=prometheus}

pidfile=/var/run/smartctl_exporter.pid
command=/usr/sbin/daemon
command_interpreter=%%PYTHON_CMD%%
procname=%%PREFIX%%/bin/smartctl-exporter
command_args="-f -p ${pidfile} /usr/bin/env ${procname} ${smartctl_exporter_args}"

start_precmd=smartctl_exporter_startprecmd

smartctl_exporter_startprecmd()
{
    if [ -e ${pidfile} ]; then
        chown ${smartctl_exporter_user}:${smartctl_exporter_group} ${pidfile};
    else
        install -o ${smartctl_exporter_user} -g ${smartctl_exporter_group} /dev/null ${pidfile};
    fi
}

run_rc_command "$1"
