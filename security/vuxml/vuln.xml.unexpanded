  <vuln vid="b2f1f86f-20e6-11ec-a574-080027eedc6a">
    <topic>nexus2-oss -- NXRM2 Directory Traversal vulnerability</topic>
    <affects>
      <package>
	<name>nexus2-oss</name>
	<range><lt>2.14.19</lt></range>
      </package>
    </affects>
    <description>
