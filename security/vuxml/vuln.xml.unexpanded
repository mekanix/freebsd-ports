  <vuln vid="f4876dd4-9ca8-11e8-aa17-0011d823eebd">
    <topic>mbed TLS -- plaintext recovery vulnerabilities</topic>
    <affects>
      <package>
	<name>mbedtls</name>
	<range><lt>2.12</lt></range>
      </package>
    </affects>
    <description>
      <body xmlns="http://www.w3.org/1999/xhtml">
