  <vuln vid="c37de843-488e-11e2-a5c9-0019996bc1f7">
    <topic>squid -- denial of service</topic>
    <affects>
      <package>
	<name>squid</name>
	<range><lt>2.7.9_4</lt></range>
	<range><ge>3.1</ge><lt>3.1.23</lt></range>
	<range><ge>3.2</ge><lt>3.2.6</lt></range>
