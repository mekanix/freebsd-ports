  <vuln vid="7927165a-0126-11e5-9d98-080027ef73ec">
    <topic>dnsmasq -- remotely exploitable buffer overflow in release candidate</topic>
    <affects>
      <package>
	<name>dnsmasq-devel</name>
	<range><ge>2.73rc6</ge><lt>2.73rc8</lt></range>
      </package>
