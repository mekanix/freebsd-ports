  <vuln vid="9704930c-3bb7-11e7-93f7-d43d7e971a1b">
    <topic>gitlab -- Various security issues</topic>
    <affects>
      <package>
	<name>gitlab</name>
	<range><ge>6.6.0</ge><le>8.17.5</le></range>
