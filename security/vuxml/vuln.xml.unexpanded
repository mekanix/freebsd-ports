      <cvename>CVE-2015-8140</cvename>
      <cvename>CVE-2015-8158</cvename>
      <url>http://support.ntp.org/bin/view/Main/SecurityNotice#January_2016_NTP_4_2_8p6_Securit</url>
    </references>
    <dates>
