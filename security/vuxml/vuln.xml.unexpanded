  <vuln vid="0d3547ab-9b69-11e1-bdb1-525401003090">
    <topic>PivotX -- 'ajaxhelper.php' Cross Site Scripting Vulnerability</topic>
    <affects>
      <package>
	<name>pivotx</name>
	<range><le>2.3.2</le></range>
      </package>
    </affects>
