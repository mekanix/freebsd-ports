  <vuln vid="83119e27-5d7c-11d8-80e3-0020ed76ef5a">
    <topic>nap allows arbitrary file access</topic>
    <affects>
      <package>
	<name>nap</name>
	<range><lt>1.4.5</lt></range>
      </package>
    </affects>
    <description>
      <body xmlns="http://www.w3.org/1999/xhtml">
	<p>According to the author:</p>
