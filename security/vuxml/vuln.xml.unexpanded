      <entry>2018-09-15</entry>
    </dates>
  </vuln>

  <vuln vid="ab38d9f8-b787-11e8-8e7a-00e04c1ea73d">
    <topic>mybb -- vulnerabilities</topic>
    <affects>
      <package>
	<name>mybb</name>
	<range><lt>1.8.19</lt></range>
      </package>
    </affects>
