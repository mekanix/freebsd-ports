      <url>http://dev.plone.org/plone/ticket/5432</url>
      <url>http://www.debian.org/security/2006/dsa-1032</url>
      <url>http://secunia.com/advisories/19633/</url>
    </references>
    <dates>
      <discovery>2006-04-13</discovery>
      <entry>2006-04-18</entry>
    </dates>
  </vuln>

