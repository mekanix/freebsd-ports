  <vuln vid="4582948a-9716-11de-83a5-001999392805">
     <topic>opera -- multiple vulnerabilities</topic>
     <affects>
       <package>
	 <name>opera</name>
	 <range><lt>10.00.20090830</lt></range>
       </package>
