  <vuln vid="1d6410e8-06c1-11ec-a35d-03ca114d16d6">
    <topic>fetchmail -- STARTTLS bypass vulnerabilities</topic>
    <affects>
      <package>
	<name>fetchmail</name>
	<range><lt>6.4.22.r1</lt></range>
      </package>
    </affects>
