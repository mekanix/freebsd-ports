  <vuln vid="f5b8b670-465c-11e5-a49d-bcaec565249c">
    <topic>gdk-pixbuf2 -- heap overflow and DoS</topic>
    <affects>
      <package>
	<name>gdk-pixbuf2</name>
	<range><lt>2.31.6</lt></range>
      </package>
    </affects>
