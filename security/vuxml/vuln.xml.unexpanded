  <vuln vid="4108cc57-54d7-11e2-9483-14dae938ec40">
    <topic>ircd-ratbox and charybdis -- remote DoS vulnerability</topic>
    <affects>
      <package>
	<name>ircd-ratbox</name>
	<range><gt>2.*</gt><lt>3.0.8</lt></range>
      </package>
      <package>
