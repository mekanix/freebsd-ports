	</blockquote>
      </body>
    </description>
    <references>
      <url>http://cve.mitre.org/cgi-bin/cvename.cgi?name=CVE-2017-17531</url>
      <url>http://lists.gnu.org/archive/html/info-global/2017-12/msg00001.html</url>
      <cvename>CVE-2017-17531</cvename>
