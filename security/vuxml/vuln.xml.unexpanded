  <vuln vid="c21f4e61-6570-11e5-9909-002590263bf5">
    <topic>codeigniter -- multiple vulnerabilities</topic>
    <affects>
      <package>
	<name>codeigniter</name>
	<range><lt>2.2.2</lt></range>
      </package>
    </affects>
