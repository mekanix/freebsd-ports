  <vuln vid="d3216606-2b47-11e5-a668-080027ef73ec">
    <topic>PolarSSL -- Security Fix Backports</topic>
    <affects>
      <package>
	<name>polarssl</name>
	<range><lt>1.2.14</lt></range>
      </package>
    </affects>
