  <vuln vid="174e466b-1d48-11eb-bd0f-001b217b3468">
    <topic>Gitlab -- Multiple vulnerabilities</topic>
    <affects>
      <package>
	<name>gitlab-ce</name>
	<range><ge>13.5.0</ge><lt>13.5.2</lt></range>
	<range><ge>13.4.0</ge><lt>13.4.5</lt></range>
