      <url>http://jvn.jp/jp/JVN%23465742E4/index.html</url>
    </references>
    <dates>
      <discovery>2005-05-19</discovery>
      <entry>2005-05-29</entry>
      <modified>2005-06-01</modified>
    </dates>
  </vuln>

