  <vuln vid="30a04ab4-ed7b-11e2-8643-8c705af55518">
    <topic>squid -- denial of service</topic>
    <affects>
      <package>
	<name>squid</name>
	<range><ge>3.2</ge><lt>3.2.12</lt></range>
