  <vuln vid="a3764767-f31e-11e7-95f2-005056925db4">
    <topic>irssi -- multiple vulnerabilities</topic>
    <affects>
      <package>
	<name>irssi</name>
	<range><lt>1.0.6,1</lt></range>
      </package>
