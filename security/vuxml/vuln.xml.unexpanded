  <vuln vid="e3e68fe8-d9cb-4ba8-b09c-9e3a28588eb7">
    <topic>firefox -- Heap buffer overflow rasterizing paths in SVG with Skia</topic>
    <affects>
      <package>
	<name>firefox</name>
	<range><lt>60.0.2,1</lt></range>
      </package>
      <package>
	<name>waterfox</name>
	<range><lt>56.2.0.13_5</lt></range>
      </package>
