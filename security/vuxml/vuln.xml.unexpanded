  <vuln vid="0d0237d0-7f68-11de-984d-0011098ad87f">
    <topic>SquirrelMail -- Plug-ins compromise</topic>
    <affects>
      <package>
	<name>squirrelmail-multilogin-plugin</name>
	<range><ge>2.3.4</ge><lt>2.3.4_2</lt></range>
