	<range><ge>5.3</ge><lt>5.3.15</lt></range>
      </package>
      <package>
	<name>php52-sqlite</name>
	<range><lt>5.2.17_11</lt></range>
      </package>
      <package>
	<name>php53-sqlite</name>
