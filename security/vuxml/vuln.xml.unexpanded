      </package>
      <package>
	<name>linux-mozilla</name>
	<name>linux-mozilla-devel</name>
	<range><lt>1.7.7</lt></range>
	<range><ge>1.8.*</ge></range>
      </package>
      <package>
	<name>netscape7</name>
	<range><ge>0</ge></range>
      </package>
