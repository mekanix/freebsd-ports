	<range><lt>13.38.1</lt></range>
      </package>
      <package>
	<name>asterisk16</name>
	<range><lt>16.15.1</lt></range>
      </package>
      <package>
	<name>asterisk18</name>
	<range><lt>18.1.1</lt></range>
