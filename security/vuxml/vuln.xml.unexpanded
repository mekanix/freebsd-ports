      <cvename>CVE-2016-0996</cvename>
      <cvename>CVE-2016-0997</cvename>
      <cvename>CVE-2016-0998</cvename>
      <cvename>CVE-2016-0999</cvename>
      <cvename>CVE-2016-1000</cvename>
      <cvename>CVE-2016-1001</cvename>
