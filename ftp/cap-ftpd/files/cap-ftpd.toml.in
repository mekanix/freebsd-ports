# Bind address and port
addr =	"127.0.0.1:21"

# Path to the password file, in json format
auth = "%%LOCALBASE%%/etc/cap-ftpd/cap-ftpd-users.json"

# Sets the range of ports used for passive connections.
passive_ports = { start = 40000, end = 50000 }

# FTP root directory.  This should be the lowest common parent directory
# of every user's home directory.  It is highly recommended not to use
# "/".
root = "/ftp"

# Path to the TLS certificate file, in PEM format.
# If undefined, TLS will not be used
# cert = "%%LOCALBASE%%/etc/cap-ftpd/cert.crt"
# Path to the TLS private key, in PEM format.
# privkey = "%%LOCALBASE%%/etc/cap-ftpd/key.key"

# Path to the worker exectuable
worker_path = "%%LOCALBASE%%/libexec/cap-ftpd-worker"
